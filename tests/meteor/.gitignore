# Meteor's local build state. Never committed.
.meteor/local/

# Tailwind CLI output, generated by `npm run build:css` before the Meteor build.
client/styles.css

# `meteor build` and `scripts/stage-static.mjs` write to the REPO ROOT
# (../../meteor-out/ and ../../meteor-static/), not here. That is deliberate:
# Meteor scans its own app directory for .html files, so a staged index.html
# left inside tests/meteor/ is read as an app file on the next build and
# static-html fails with "Can't set DOCTYPE here."; and verify-all.mjs counts
# every directory under tests/ as an environment. Both are gitignored at the root.
