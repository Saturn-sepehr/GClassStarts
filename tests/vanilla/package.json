{
  "name": "gclass-tests-vanilla",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "gclass-anims with no bundler - resolved through a browser import map",
  "scripts": {
    "dev": "tailwindcss -i ./src/styles.css -o ./dist/styles.css --watch & npx --yes serve . -l 5173",
