    "preview": "npx --yes serve . -l 4173"
  },
  "dependencies": {
    "gclass-anims": "1.0.0-beta.23"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
